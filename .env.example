# Majordomo configuration — copy to .env and adjust. Every setting has a
# working default; you only need this file to change something.

# Where state lives: memory files, sessions, schedules, and the workspace.
# Default: ~/.majordomo
#MAJORDOMO_DATA_DIR=/home/you/.majordomo

# Provider: "ollama" (local, no key — the default), "openai"
# (OpenAI-compatible), or "fake" (scripted, offline; powers the demo).
#MAJORDOMO_PROVIDER=ollama

# Ollama (local models)
#MAJORDOMO_OLLAMA_BASE_URL=http://localhost:11434
#MAJORDOMO_OLLAMA_MODEL=llama3.1

# OpenAI-compatible provider (also used by the live image backend)
#MAJORDOMO_OPENAI_BASE_URL=https://api.openai.com/v1
#MAJORDOMO_OPENAI_MODEL=gpt-4o-mini
#MAJORDOMO_OPENAI_API_KEY=

# Image generation backend: "fake" (placeholder PNG, the default) or
# "openai" (live, uses MAJORDOMO_OPENAI_API_KEY — your key, your bill).
#MAJORDOMO_IMAGE_BACKEND=fake

# MCP servers config file (JSON, see examples/mcp-servers.json). Leave
# unset for no MCP servers.
#MAJORDOMO_MCP_CONFIG=/home/you/mcp-servers.json

# Mail tools (IMAP for reading, SMTP for sending — standard library
# only). All five are needed for a live mailbox; without them the mail
# tools report "not configured". Offline/fake runs use a fake mailbox.
#MAJORDOMO_MAIL_ADDRESS=you@example.com
#MAJORDOMO_MAIL_USERNAME=you@example.com
#MAJORDOMO_MAIL_PASSWORD=<redacted>
#MAJORDOMO_MAIL_IMAP_HOST=imap.example.com
#MAJORDOMO_MAIL_SMTP_HOST=smtp.example.com
#MAJORDOMO_MAIL_SMTP_PORT=587

# Self-filing memory: when true, simple statements in your messages
# ("my favourite coffee is ...", "remember ...") are filed to memory
# after each turn. Questions, commands, and chit-chat are never filed.
# Off by default.
#MAJORDOMO_AUTO_MEMORY=false

# Web app bind for `majordomo serve`.
#MAJORDOMO_HOST=127.0.0.1
#MAJORDOMO_PORT=8080
